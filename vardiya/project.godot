; Engine configuration file.
; VARDIYA - NexDrive Game Studio

config_version=5

[application]

config/name="VARDİYA"
config/description="Karaliman: a branching story about a worker family and automation."
config/version="0.8.5"
config/icon="res://icon.png"
run/main_scene="res://ui/main_menu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="vardiya"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0.06, 0.07, 0.08, 1)
boot_splash/show_image=false

[autoload]

InputRouter="*res://autoload/input_router.gd"
Localization="*res://autoload/localization.gd"
AudioBus="*res://autoload/audio_bus.gd"
GameState="*res://autoload/game_state.gd"
DecisionManager="*res://autoload/decision_manager.gd"
SaveSystem="*res://autoload/save_system.gd"
DialogueRunner="*res://autoload/dialogue_runner.gd"
SceneLoader="*res://autoload/scene_loader.gd"
PerfMonitor="*res://autoload/perf_monitor.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[internationalization]

locale/fallback="tr"

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
environment/defaults/default_clear_color=Color(0.06, 0.07, 0.08, 1)
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
shading/overrides/force_vertex_shading=true
limits/opengl/max_lights_per_object=8
lights_and_shadows/positional_shadow/atlas_size=1024
textures/default_filters/anisotropic_filtering_level=1
