; Engine configuration file.
; Godot 4.7 project: Ufuk Yolu / Horizon Road

config_version=5

[application]

config/name="Horizon Road"
config/description="Ufuk Yolu: a calm, low-poly exploration game about travelling Türkiye in a camper."
run/main_scene="res://regions/blacksea_highland/blacksea_highland.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/version="0.9.0"

[autoload]

GameState="*res://autoload/game_state.gd"
TimeManager="*res://autoload/time_manager.gd"
WeatherManager="*res://autoload/weather_manager.gd"
SaveManager="*res://autoload/save_manager.gd"
Localization="*res://autoload/localization.gd"
AudioManager="*res://autoload/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.en.translation", "res://localization/strings.tr.translation", "res://localization/dialogue.en.translation", "res://localization/dialogue.tr.translation")
locale/fallback="en"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96

[shader_globals]

wetness={
"type": "float",
"value": 0.0
}
wind_strength={
"type": "float",
"value": 0.3
}
snow_cover={
"type": "float",
"value": 0.0
}
night_lights={
"type": "float",
"value": 0.0
}
cloud_shadow_strength={
"type": "float",
"value": 0.0
}
cloud_coverage={
"type": "float",
"value": 0.3
}
cloud_shadow_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
season_tint={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
