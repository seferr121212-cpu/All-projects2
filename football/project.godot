[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="ball"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
jolt_physics_3d/limits/max_angular_velocity=600.0

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2

[autoload]

Game="*res://scripts/ui/game.gd"

[internationalization]

locale/translations=PackedStringArray("res://assets/translations/strings.tr.translation", "res://assets/translations/strings.en.translation")
locale/fallback="tr"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
